# Copie para .env (local) ou cadastre em Vercel > Settings > Environment Variables (Production).

# Postgres (Neon / Vercel Postgres). Obrigatório na Vercel; em dev local, se vazio, usa SQLite (zera.db).
DATABASE_URL=postgresql://usuario:senha@host/banco

# Chave das sessões. Obrigatória na Vercel. Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Senha do usuário admin criado quando o banco está vazio. Se vazio, uma senha aleatória é gerada e exibida no terminal.
ADMIN_PASSWORD=
